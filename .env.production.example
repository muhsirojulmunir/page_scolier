# =============================================================================
# Contoh .env untuk PRODUKSI (Hostinger)
# =============================================================================
# Salin isi berkas ini menjadi `.env` DI SERVER, lalu sesuaikan APP_URL.
# JANGAN mengunggah .env lokal — isinya untuk komputermu, bukan server.
#
# Landing page ini tidak memakai database sama sekali. Session dan cache
# diarahkan ke `file` supaya tidak perlu membuat database, menjalankan
# migrasi, atau mengurus kredensial MySQL di Hostinger.
# =============================================================================

APP_NAME=Scolier
APP_ENV=production

# WAJIB diisi. Jalankan `php artisan key:generate` di server,
# atau tempel kunci yang dihasilkan perintah tersebut di komputermu.
APP_KEY=

# WAJIB false di produksi. Kalau true, pesan error menampilkan
# isi konfigurasi dan jalur berkas ke publik.
APP_DEBUG=false

# Ganti dengan domain aslimu, tanpa garis miring di akhir.
APP_URL=https://scolier.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# Hanya catat peringatan ke atas, supaya log tidak membengkak.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Tanpa database: session, cache, dan antrean memakai berkas.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Belum ada formulir yang mengirim email. Biarkan `log` sampai dibutuhkan.
MAIL_MAILER=log

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
